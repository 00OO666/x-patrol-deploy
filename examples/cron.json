{
  "name": "X巡检+智能部署",
  "schedule": {
    "kind": "cron",
    "expr": "0 9 * * *",
    "tz": "Asia/Shanghai"
  },
  "sessionTarget": "isolated",
  "wakeMode": "now",
  "payload": {
    "kind": "agentTurn",
    "message": "执行 x-patrol-deploy Skill（~/.openclaw/skills/x-patrol-deploy/SKILL.md）。",
    "timeoutSeconds": 3600
  },
  "delivery": {
    "mode": "announce",
    "channel": "telegram",
    "to": "YOUR_GROUP_ID",
    "bestEffort": true
  }
}
